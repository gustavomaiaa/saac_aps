PORT=3000

# OBRIGATORIO: o servidor NAO inicia sem um segredo forte (minimo de 32 caracteres) e recusa valores de exemplo.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Codigo de convite exigido no cadastro de novos usuarios (tela de cadastro). Sem ele o cadastro fica desativado.
# O usuario admin criado por "npm run seed" faz login normalmente, sem convite.
CODIGO_CONVITE=

# IA local (Ollama) — nenhum dado sai da maquina
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Seguranca
# Origem(ns) do frontend permitidas no CORS (separadas por virgula)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
# Limite de tentativas FALHAS de login por IP + e-mail (padrao: 5 em 15 min)
#LOGIN_MAX_TENTATIVAS=5
#LOGIN_JANELA_MS=900000

OLLAMA_EMBED_MODEL=nomic-embed-text
# Achados semelhantes: similaridade minima e limiar de possivel duplicidade
SEMELHANTES_LIMIAR=0.80
SEMELHANTES_LIMIAR_DUPLICIDADE=0.90

# Limites de taxa (valores padrao)
#CADASTRO_LIMITE_POR_HORA=10
#IA_LIMITE_POR_MINUTO=10
#IA_LIMITE_SEMELHANTES_POR_MINUTO=30
